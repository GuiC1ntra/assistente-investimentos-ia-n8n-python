            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"model\": \"gpt-4o-mini\",\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"Você é um assistente financeiro que escreve briefings diários de investimentos, claros e objetivos, em português.\" },\n    { \"role\": \"user\", \"content\": \"Gere um briefing diário com base nestes dados: \" + JSON.stringify($json) }\n  ]\n} }}",
        "options": {}
      },
      "id": "1f6a2b10-0001-4a11-9c1a-000000000006",
      "name": "HTTP Request - LLM (Gera Briefing)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 280]
    },
    {
      "parameters": {
        "jsCode": "// Extrai o texto gerado pelo LLM e monta o corpo do e-mail em HTML\nconst respostaLlm = $input.first().json;\nconst textoBriefing = respostaLlm.choices?.[0]?.message?.content ?? 'Não foi possível gerar o briefing hoje.';\n\nconst html = `\n  <h2>Briefing Diário de Investimentos</h2>\n  <p>${textoBriefing.replace(/\\n/g, '<br>')}</p>\n  <hr>\n  <small>Gerado automaticamente via n8n + IA.</small>\n`;\n\nreturn [{\n  json: {\n    destinatario_email: $('Code - Consolida Dados').first().json.destinatario_email,\n    assunto: `Briefing de Investimentos - ${new Date().toLocaleDateString('pt-BR')}`,\n    corpo_html: html,\n  }\n}];\n"
      },
