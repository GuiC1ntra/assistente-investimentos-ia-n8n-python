    {
      "parameters": {
        "jsCode": "// Normaliza e valida o payload recebido do script Python (Colab)\nconst body = $input.first().json.body ?? $input.first().json;\n\nif (!body || !Array.isArray(body.ativos) || body.ativos.length === 0) {\n  throw new Error('Payload inválido: campo \"ativos\" ausente ou vazio.');\n}\n\nif (!body.destinatario_email) {\n  throw new Error('Payload inválido: \"destinatario_email\" não informado.');\n}\n\nreturn [{\n  json: {\n    origem: body.origem ?? 'desconhecida',\n    gerado_em: body.gerado_em ?? new Date().toISOString(),\n    destinatario_email: body.destinatario_email,\n    ativos: body.ativos,\n  }\n}];\n"
      },
      "id": "1f6a2b10-0001-4a11-9c1a-000000000003",
      "name": "Code - Normaliza Payload Colab",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
