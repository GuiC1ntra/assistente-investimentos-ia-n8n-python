      "id": "1f6a2b10-0001-4a11-9c1a-000000000004",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [340, 280]
    },
    {
      "parameters": {
        "jsCode": "// Consolida os dois ramos (dados de mercado + payload do Colab) em um único objeto\nconst mercado = $items('HTTP Request - Dados de Mercado')[0].json;\nconst colab = $items('Code - Normaliza Payload Colab')[0].json;\n\nreturn [{\n  json: {\n    ...colab,\n    dados_mercado_complementares: mercado,\n  }\n}];\n"
      },
      "id": "1f6a2b10-0001-4a11-9c1a-000000000005",
      "name": "Code - Consolida Dados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
